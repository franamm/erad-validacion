# ============================================================
# Configuración de un caso para servidor/correr_caso.sh
# ============================================================
# Copiar como casos/<mi_red>.env y ajustar. Es bash: sin espacios alrededor
# del '='. Lo que NO está acá (escenarios, horizonte, horas de reparación,
# seccionadores, buses críticos, tie-lines) vive en red_nueva.pkl y se
# decide UNA vez, con crear_caso.py: así el Monte Carlo, E2, E5 y el
# barrido no pueden quedar con números distintos.

CASO=mi_red                      # carpeta <caso>/datos/artefactos/<CASO>, la de crear_caso.py

# Carpeta del caso de estudio (solo datos: datos/, Proyecto oficial/). Vacío =
# caso_validacion. Tiene que ser la misma con que se corrió crear_caso.py.
# ERAD_CASO="$APP_DIR/../../caso_elmelon"

# Intérprete del entorno (instalar.sh lo deja en erad-env/ de la raíz del repo)
PYTHON="$APP_DIR/../../../../erad-env/bin/python"

# ── Fallas ───────────────────────────────────────────────────
FALLAS=clima                     # clima = cadena validada · sinteticas = solo para probar
HORAS=                           # vacío = horizonte completo. 48 = prueba rápida del flujo

# ── Clima (etapa 'clima', necesita internet) ─────────────────
OPENMETEO_DESDE=2017-01-01       # histórico horario Open-Meteo (ecmwf_ifs parte en 2017)
OPENMETEO_HASTA=2025-12-31
ANIO_PREVIO=2023                 # año observado que va al primer año del .nc
ANIO_OPERATIVO=2024              # el que lee construir_faultlin (offset 8760)
ARCLIM_MIEMBRO=                  # vacío = mediana entre GCM de ARClim
# CLIMA_NC=/ruta/a/BaseHoraEWE_x.nc   # para usar un .nc generado en otro lado

# ── Monte Carlo ──────────────────────────────────────────────
CURVA=dunn                       # la vigente del estudio
SEMILLA=42

# ── E4 (caso sin fallas) — tiene que ser el MISMO tope en el barrido ──
LIM_DG=0.3
LIM_DG_MODO=alimentador          # bus | alimentador | zona | seccion

# ── E5 / barrido ─────────────────────────────────────────────
SECCIONADORES=paquete            # paquete = los de red_nueva.pkl · ninguno · o 0,2,9
N_ESTRATOS=10                    # tamaño de la muestra estratificada por ENS

BARRIDO_MEDIDAS=reconfig_topo,dg_sol,dg_eol,dg_fos,ess_4h,ess_5h,ess_6h,meg,mess,edrp,refuerzo,soterramiento
BARRIDO_ESCENARIOS=              # vacío = la muestra estratificada
BARRIDO_FASES=1,2,3              # 1 individual · 2 representativos · 3 combinadas
BARRIDO_SALIDA=principal         # artefactos/<CASO>/barrido/<esto>
MIP_GAP=0.02
TIME_LIMIT=86400                 # por corrida, en s. Un corte devuelve el incumbente con su gap
# Unidades móviles: los mismos valores que la tanda "oficial" de Oberrhein.
# Para Gurobi: --threads N --mem_gb G --method 1 (simplex dual, menos RAM que barrier)
BARRIDO_EXTRA="--n_meg 3 --p_meg_max 300 --t_tra_meg 2 --n_mess 3 --h_mess 3.0 --p_mess_max 200 --t_tra_mess 2"
# --no-completo ahorra ~4.5 MB y ~9 s por corrida, pero sin el .pkl.gz la corrida
# no se puede abrir después en la pestaña Resultados de la app.

# ── Recursos (opcional) ──────────────────────────────────────
# Por defecto se detectan del trabajo (affinity, cgroup, SLURM): ver recursos.py.
# export ERAD_CPUS=16
# export ERAD_RAM_GB=120
# Temporales grandes (LP de 8760 h, nodefiles de Gurobi). Por defecto
# artefactos/<CASO>/tmp. En un servidor con /scratch, conviene ahí:
# export TMPDIR=/scratch/$USER/erad_tmp
