# Prueba de humo: la cadena completa en minutos, sin internet.
# CIGRE MV + fallas sintéticas + horizonte de 720 h + 2 medidas.
# 720 y no 48: la primera falla sintética de estos escenarios cae en la hora
# ~430, y una prueba sin fallas (ENS = 0) no prueba nada.
# Sirve para saber si el servidor está bien instalado, NO para la tesis.
#
#   python crear_caso.py prueba_cigre --red cigre --n-zonas 3 --sin-puntos \
#       --criticos 6,11,14 --seccionadores ninguno --escenarios 4 --horas-reparacion 3
#   servidor/correr_caso.sh servidor/casos/prueba_cigre.env

CASO=prueba_cigre
PYTHON="${PYTHON:-$APP_DIR/../../../../erad-env/bin/python}"
FALLAS=sinteticas
HORAS=720
N_ESTRATOS=2
BARRIDO_MEDIDAS=dg_sol,ess_4h
BARRIDO_FASES=1,2,3
BARRIDO_SALIDA=humo
TIME_LIMIT=600
BARRIDO_EXTRA="--no-completo"
